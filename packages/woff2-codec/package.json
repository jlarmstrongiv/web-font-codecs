{
  "name": "woff2-codec",
  "version": "0.2.1",
  "type": "module",
  "description": "Google WOFF2 encoder and decoder compiled from source to WebAssembly.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": {
        "web-font-codecs:source": "./src/index.ts",
        "default": "./dist/index.d.ts"
      },
      "web-font-codecs:source": {
        "node": "./src/node.ts",
        "default": "./src/index.ts"
      },
      "node": "./dist/node.js",
      "default": "./dist/index.js"
    },
    "./codec.wasm": "./wasm/codec.wasm"
  },
  "files": [
    "src",
    "dist",
    "wasm",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "upstream-source",
    "LICENSING.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "web-font-codecs-core": "0.2.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build.ts woff2-codec",
    "prepack": "node ../../scripts/build.ts woff2-codec"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlarmstrongiv/web-font-codecs.git",
    "directory": "packages/woff2-codec"
  },
  "homepage": "https://jlarmstrongiv.github.io/web-font-codecs/",
  "bugs": {
    "url": "https://github.com/jlarmstrongiv/web-font-codecs/issues"
  }
}
